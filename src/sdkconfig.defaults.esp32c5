# esp32c5 bootloader loads from 0x2000; keep the same 32KB bootloader window as esp32c3
# by moving the partition table from 0x8000 to 0xa000. The custom partition table keeps
# the app at 0x10000, so everything from 0x10000 up (IAP / OTA / user data / conf page)
# is identical to esp32c3.
CONFIG_PARTITION_TABLE_OFFSET=0xa000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_c5.csv"
